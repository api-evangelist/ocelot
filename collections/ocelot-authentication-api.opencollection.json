{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ocelot Administration Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue an admin access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:5000/administration/connect/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                },
                {
                  "name": "grant_type",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Issues an OAuth 2.0 access token using the client credentials flow. The returned bearer token must be supplied to subsequent Administration API calls."
        }
      ]
    }
  ],
  "bundled": true
}